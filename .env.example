# ==============================================================
# Catalyst Capital - Environment Variables Configuration
# ==============================================================

# Neon Serverless PostgreSQL Database Connection String
# Get this from your Neon Console (https://console.neon.tech)
# Example: postgresql://username:password@ep-sample-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/catalystcapital?sslmode=require

# JWT Secret for User Authentication Tokens
JWT_SECRET=catalyst_capital_super_secret_jwt_key_2026

# Vercel Cron Secret (Optional, used to secure /api/cron/daily-roi)
CRON_SECRET=catalyst_cron_secret_random_token_123

# Local Development Port
PORT=5000
